# API base URL (optional; axios in src/services/api.js defaults to
# http://localhost:8000/api when unset).
# VITE_API_URL=http://localhost:8000/api

# Set to 'true' to access the app without logging in (e.g. when backend is down).
# Only use for local development.
VITE_DEV_BYPASS_AUTH=false

# Vite exposes only variables prefixed with VITE_ to client code, via
# import.meta.env. The mode (development / production / test) is available
# as import.meta.env.MODE.
